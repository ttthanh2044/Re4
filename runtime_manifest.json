  "runtime_architecture": {
    "movement_speed_source": "config.lua -> Movement.TweenSpeed (200)",
    "movement_entry_point": "RE4RequestMovement(destination, context) -> RE4MovementCoordinator -> RE4TravelResolver",
    "fighting_style_data": "RE4Constants.FeatureMetadata.GameData.FightingStyleCatalog is canonical for Dark Step/Electric/Water Kung Fu; RE4Constants.StyleMeta derives runtime fields from it",
    "fighting_style_action": "Progression Auto Get and Items Use/Equip share RE4StyleProgress.StartDealerAction -> MoveDealer -> Invoke -> ownership/equip verification",
    "fighting_style_dealer_resolution": "live/template NPC resolver -> shared TeleportDirectory -> exact per-Sea/style cache -> island anchor only as bootstrap -> exact dealer rescan",
    "dealer_anchor_policy": "WorldTopology island anchors are never cached or treated as dealer positions",
    "items_use_auto_buy": false,
    "bringmob": "unchanged from 2.0.13",
    "fastattack": "unchanged from 2.0.13",
    "dynamic_tween": "removed"
  },
  "update_2_0_14": {
    "root_cause": [
      "Basic Fighting Style data existed twice (FightingStyleCatalog and literal StyleMeta fields), creating drift risk.",
      "Exact dealer targets resolved during Progression were not retained. If the NPC/template became temporarily unresolvable during Items Equip, MoveDealer degraded to the generic island anchor and could end with dealer_not_loaded."
    ],
    "fix": {
      "canonical_basic_style_catalog": true,
      "style_meta_derived_from_catalog": true,
      "shared_progression_items_transaction": true,
      "teleport_directory_npc_registry_reused": true,
      "exact_dealer_cache_key": "Sea + CatalogKey/style",
      "anchor_cached_as_dealer": false,
      "old_dealer_not_loaded_region_error_removed": true,
      "items_use_purchase_permission": false
    }
  },
  "offline_regression": {
    "invariants": {
      "fixed_tween_speed_200": true,
      "dynamic_tween_removed": true,
      "progression_and_items_same_start_dealer_action": true,
      "progression_and_items_same_move_dealer": true,
      "basic_style_data_single_canonical_source": true,
      "dealer_exact_position_reused_between_flows": true,
      "island_anchor_bootstrap_only": true,
      "items_use_never_buys_unowned_style": true,
      "no_new_scheduler_or_polling_loop": true
    },
    "scope_preservation": {
      "config.lua": true,
      "ui.lua": true,
      "language/en.json": true,
      "language/vi.json": true,
      "language/th.json": true,
      "language/id.json": true,
      "language/manifest.json": true,
      ".gitignore": true,
      "movement_core_changed": false,
      "bring_core_changed": false,
      "fastattack_changed": false
    },
    "callsite_counts": {
